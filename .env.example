# Copy to .env and fill in. Generate keys, tokens and the gateway secret with:
#   pnpm --filter @smsai/server admin genkey
#   (or: docker compose -f deployments/compose.yaml run --rm api node dist/admin.js genkey)
# Values starting with REPLACE_ / CHANGE_ME / SET_AFTER are treated as unset.

APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://smsai:smsai_dev_password@localhost:5442/smsai?sslmode=disable
AUTO_MIGRATE=true
EMBEDDED_WORKER=false
LOG_LEVEL=info

# Key versioning (plan ADR-008). Add V2 keys and set CURRENT_KEY_VERSION=2 to
# rotate; keep V1 until `admin rekey` has run. Development without keys uses
# built-in INSECURE keys (refused elsewhere).
CURRENT_KEY_VERSION=1
ENCRYPTION_KEYS_V1=REPLACE_WITH_32_BYTE_BASE64_KEY
HMAC_KEYS_V1=REPLACE_WITH_32_BYTE_BASE64_SECRET

# --- SMS channel -------------------------------------------------------------
# "gateway" = the Android phone (apps/gateway). "mock" = the browser simulator,
# accepted only when APP_ENV is development or test. There is no default.
PRIMARY_SMS_PROVIDER=
# Conversation key for texts to the gateway SIM (any stable label).
SMS_SERVICE_ID=GATEWAY-SIM
INBOUND_DEBOUNCE_MS=2500
INBOUND_COALESCE_EXTEND_MS=1500
INBOUND_MAX_COALESCE=3

# The phone signs every request with this secret (24+ random characters).
# Comma-separate two values to rotate: the first is the one `admin gateway-pair` hands out.
GATEWAY_DEVICE_SECRET=REPLACE_WITH_RANDOM
# The gateway SIM's own number: texts from it are never answered (loop guard).
GATEWAY_PHONE_NUMBER=
# Public origin the phone talks to (a Cloudflare tunnel or the pilot VM), e.g. https://sms.example.com.
# Only used to print the pairing QR code.
GATEWAY_PUBLIC_URL=
# Replies the phone has not collected after this long are given up (segments refunded).
GATEWAY_OUTBOX_TTL_SECONDS=21600
# Replies the phone took but never reported on are flagged for an operator after this long.
GATEWAY_ACK_TIMEOUT_SECONDS=1800
# The phone counts as offline (log warning) after this long without a heartbeat.
GATEWAY_OFFLINE_AFTER_SECONDS=300

# Mock gateway (development only): webhook HMAC secret and optional delivery-receipt callback.
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
MOCK_DLR_CALLBACK_URL=

# --- AI ----------------------------------------------------------------------
# DeepInfra (real). LLM_PROVIDER=mock is a development/test simulator.
LLM_PROVIDER=deepinfra
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_API_KEY=REPLACE_VIA_SECRET_MANAGER
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=300
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=15000
# USD per 1M tokens, "model=in:out,..." — verify against DeepInfra pricing.
LLM_PRICES=openai/gpt-oss-20b=0.03:0.14
MOCK_LLM_LATENCY_MS=400

# --- Quotas and spend safeguards ----------------------------------------------
DAILY_PER_NUMBER_FREE_CAP=15
# Every segment leaves from a personal SIM: keep this modest for the pilot.
GLOBAL_DAILY_SMS_SEGMENT_CAP=200
GLOBAL_DAILY_SPEND_CAP_USD=15.00
# What one outgoing SMS costs you on your bundle, in USD.
SMS_SEGMENT_COST_USD=0.025
CONTEXT_TTL_HOURS=24
CONTEXT_MAX_TURNS=6
CONTEXT_MAX_INPUT_TOKENS=800
RETENTION_DAYS=30
MAX_MORE_PAGES=1
PER_NUMBER_RATE_LIMIT_PER_MINUTE=6
MAX_FAILED_CODE_ATTEMPTS_PER_DAY=5
ALLOW_UCS2_LOCAL_LANGUAGE=true

# Admin & metrics (required outside development)
ADMIN_API_TOKEN=REPLACE_VIA_SECRET_MANAGER
METRICS_TOKEN=REPLACE_VIA_SECRET_MANAGER

# Grounding store: a path overrides data/ghana_grounding_seed.yaml
GROUNDING_SEED_PATH=
GROUNDING_REFRESH_SECONDS=300

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_MS=500
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
# Serve the worker's own /metrics on this port (0 = off).
WORKER_METRICS_PORT=0
