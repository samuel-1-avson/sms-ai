# Copy to .env and fill in. Generate keys and tokens with:
#   docker compose -f deployments/compose.yaml run --rm api /app/admin genkey
# Values starting with REPLACE_ / CHANGE_ME / SET_AFTER are treated as unset.

APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://smsai:smsai_dev_password@localhost:5442/smsai?sslmode=disable
AUTO_MIGRATE=true
EMBEDDED_WORKER=false
LOG_LEVEL=info

# Cryptographic key versioning (plan ADR-008). Add V2 keys and set
# CURRENT_KEY_VERSION=2 to rotate; keep V1 until `admin rekey` has run.
# Development without keys uses built-in INSECURE keys (refused elsewhere).
CURRENT_KEY_VERSION=1
ENCRYPTION_KEYS_V1=REPLACE_WITH_32_BYTE_BASE64_KEY
HMAC_KEYS_V1=REPLACE_WITH_32_BYTE_BASE64_SECRET

# Channel & provider settings. No default: name a real provider. "mock" is a simulator accepted only when APP_ENV is development or test.
# "mnotify" (mNotify, mnotify.com: USSD and outbound SMS on one account) is the chosen provider. "mtn" (dropped after
# two OAuth 401s and company-only production vetting), "hubtel" and "arkesel" exist but are dormant (not in use).
# See docs/PROVIDER_VALIDATION.md before switching to a real provider.
PRIMARY_SMS_PROVIDER=
PRIMARY_USSD_PROVIDER=
# sandbox | live. mNotify has NO sandbox: PRIMARY_SMS_PROVIDER=mnotify requires live, and every message is real and billed.
# With Arkesel, sandbox sends are accepted but never delivered or billed.
# Hubtel has NO sandbox either: PRIMARY_SMS_PROVIDER=hubtel requires live.
# MTN: the environment is the host. live = api.mtn.com (real and billed), sandbox = sandbox.api.mtn.com;
# validation refuses a mismatch with MTN_BASE_URL.
SMS_ENVIRONMENT=sandbox
SMS_SERVICE_ID=SET_AFTER_APPROVAL
USSD_SERVICE_CODE=*713*1#
# Registered alphanumeric sender ID (mNotify, Arkesel, Hubtel and MTN: 1-11 characters). mNotify must have approved it
# for your account (`admin mnotify-sender-status` asks).
SMS_OUTBOUND_SENDER_ID=SMS-AI
INBOUND_DEBOUNCE_MS=2500
INBOUND_COALESCE_EXTEND_MS=1500
INBOUND_MAX_COALESCE=3
USSD_FAST_PATH_TIMEOUT_MS=3200
USSD_MAX_CHARS=182
USSD_SESSION_TTL_SECONDS=180

# Mock gateway (development only): webhook HMAC secret and optional
# delivery-receipt callback.
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret
MOCK_DLR_CALLBACK_URL=

# mNotify (PRIMARY_SMS_PROVIDER and/or PRIMARY_USSD_PROVIDER=mnotify): Quick SMS for outbound messages, shared or
# dedicated USSD callbacks. The only authority is its OpenAPI file https://developer.bms.africa/openapi14.yaml;
# docs/PROVIDER_VALIDATION.md lists what it confirms and what is open (USSD price and provisioning, callback
# registration, source IPs, error codes, ...). Delivery reports do not exist: messages stay 'submitted'.
# API key from the mNotify dashboard (Settings > Developer). It is sent as ?key= in the URL of every outbound call, so
# it is a secret: the app never logs request URLs, and `admin mnotify-status` shows it only as set / NOT SET.
MNOTIFY_API_KEY=REPLACE_VIA_SECRET_MANAGER
# Host and path prefix of the API; the client appends the operation path and ?key=.
MNOTIFY_BASE_URL=https://api.mnotify.com/api
# auto | shared | dedicated. mNotify offers USSD on a shared code (payload msisdn/sequenceID/data) and on your own
# dedicated code (msIsdn/sessId/text/ussdGwId); auto serves both on one route, a fixed mode refuses the other shape.
MNOTIFY_USSD_MODE=auto
# mNotify wants CRLF (carriage return + line feed) line breaks (the adapter converts them). If its gateway turns out to count both characters
# against the screen limit, lower USSD_MAX_CHARS (e.g. 170).
# mNotify documents no callback authentication, so the USSD callback URL carries a token (24+ random characters; two
# comma-separated values allow rotation). With none set every USSD callback is refused:
#   USSD callback: https://<host>/webhooks/ussd/mnotify/session?token=<MNOTIFY_USSD_TOKEN>
# How the URL is registered with mNotify (dashboard or support) is not published.
MNOTIFY_USSD_TOKEN=REPLACE_VIA_SECRET_MANAGER
# Optional allowlist of mNotify's callback source addresses (IPs or CIDRs); mNotify does not publish them.
MNOTIFY_USSD_ALLOWED_IPS=
# Header carrying the caller's address when a reverse proxy sets it (the pilot Caddyfile sets X-Real-IP). Empty = TCP peer.
MNOTIFY_CLIENT_IP_HEADER=

# MTN's own developer platform (dormant; PRIMARY_SMS_PROVIDER and/or PRIMARY_USSD_PROVIDER=mtn): USSD interface, SMS V2, OAuth V1
# and delivery notifications (docs/PROVIDER_VALIDATION.md lists what MTN's Swagger files confirm and what is open).
# Credentials: the app's Consumer Key and Secret from developers.mtn.com (an approved production app, see the doc).
MTN_CLIENT_ID=REPLACE_VIA_SECRET_MANAGER
MTN_CLIENT_SECRET=REPLACE_VIA_SECRET_MANAGER
# x-api-key of the USSD API. MTN's FAQ says it is the Consumer Key, so empty means "use MTN_CLIENT_ID".
MTN_API_KEY=
# API host: https://api.mtn.com (live) or https://sandbox.api.mtn.com (sandbox); a country host such as
# https://ghana.api.mtn.com only if MTN gives you one.
MTN_BASE_URL=https://api.mtn.com
# OAuth V1 token endpoint. Empty = <MTN_BASE_URL>/v1/oauth/access_token.
MTN_TOKEN_URL=
# Product schemas: SMS V2 uses OAuth only; USSD uses x-api-key only. MTN's general docs differ.
# Enable these only when MTN or sandbox results confirm an extra credential is needed.
MTN_SMS_SEND_API_KEY=false
MTN_USSD_SEND_BEARER=false
# Untested: enable only after sandbox proves requestId-path lookup by our clientCorrelator.
# Failures never authorize a resend; default unknown_timeout sends need an operator.
MTN_SMS_LOOKUP_BY_CLIENT_REF=false
# MTN signs and authenticates nothing, so each callback URL carries a token (24+ random characters each;
# comma-separate two while rotating):
#   USSD callback:          https://<host>/webhooks/ussd/mtn/session?token=<MTN_USSD_TOKEN>
#   Delivery notifications: https://<host>/webhooks/sms/mtn/status?token=<MTN_DLR_TOKEN>
# `admin mtn-subscribe` registers both with MTN (printing the URLs with the token redacted).
MTN_USSD_TOKEN=REPLACE_VIA_SECRET_MANAGER
# Without this every delivery notification is refused and delivery registration is blocked.
MTN_DLR_TOKEN=REPLACE_VIA_SECRET_MANAGER
# Public https origin MTN will call (no path); used only by `admin mtn-subscribe`.
MTN_CALLBACK_BASE_URL=
# Dialled code registered for USSD. Empty = USSD_SERVICE_CODE.
MTN_USSD_SERVICE_CODE=
# SMS V2 subscriptions use SMS_OUTBOUND_SENDER_ID in the path and notifyUrl in the body.
# Required x-country-code header; GH assumes ISO alpha-2, format unconfirmed by MTN.
MTN_COUNTRY_CODE=GH
# "targetSystem" of both subscriptions: a name for this service (MTN's examples are AYO and Golden-Bank).
MTN_TARGET_SYSTEM=sms-ai-ghana
# Set true only if MTN turns out to send the whole "1*2*text" history in ussdString on continued steps.
MTN_USSD_INPUT_IS_HISTORY=false
# Optional allowlists of MTN's source addresses (IPs or CIDRs); MTN does not publish them.
MTN_USSD_ALLOWED_IPS=
MTN_DLR_ALLOWED_IPS=
# Behind a reverse proxy that OVERWRITES this header with the client address
# (e.g. X-Real-IP), name it so the allowlists see the real caller.
MTN_CLIENT_IP_HEADER=
# Ids that `admin mtn-subscribe` prints (not secrets). MTN offers no way to list subscriptions, so
# record them here; `admin mtn-unsubscribe` and `admin mtn-status` read them.
MTN_USSD_SUBSCRIPTION_ID=
MTN_SMS_SUBSCRIPTION_ID=

# Hubtel (dormant; PRIMARY_SMS_PROVIDER and/or PRIMARY_USSD_PROVIDER=hubtel). Hubtel signs no callbacks, so each
# callback URL carries a token (24+ random characters each; comma-separate two while rotating):
#   USSD Service Interaction URL: https://<host>/webhooks/ussd/hubtel/session?token=<HUBTEL_USSD_TOKEN>
#   Delivery reports:             https://<host>/webhooks/sms/hubtel/status?token=<HUBTEL_DLR_TOKEN>
# SMS API key pair from the Hubtel dashboard (HTTP Basic auth).
HUBTEL_CLIENT_ID=REPLACE_VIA_SECRET_MANAGER
HUBTEL_CLIENT_SECRET=REPLACE_VIA_SECRET_MANAGER
HUBTEL_SMS_BASE_URL=https://sms.hubtel.com
HUBTEL_USSD_TOKEN=REPLACE_VIA_SECRET_MANAGER
# Without this every delivery report is refused and messages stay 'submitted'.
HUBTEL_DLR_TOKEN=REPLACE_VIA_SECRET_MANAGER
# Optional allowlists of Hubtel's source addresses (IPs or CIDRs); Hubtel does not publish them.
HUBTEL_USSD_ALLOWED_IPS=
HUBTEL_DLR_ALLOWED_IPS=
# Behind a reverse proxy that OVERWRITES this header with the client address
# (e.g. X-Real-IP), name it so the allowlists see the real caller.
HUBTEL_CLIENT_IP_HEADER=

# Arkesel (dormant; PRIMARY_SMS_PROVIDER and/or PRIMARY_USSD_PROVIDER=arkesel).
# API key from the Arkesel dashboard (SMS API page).
ARKESEL_API_KEY=REPLACE_VIA_SECRET_MANAGER
ARKESEL_BASE_URL=https://sms.arkesel.com
# Delivery reports: public URL of this service's status webhook, without a
# query string, e.g. https://api.example.com/webhooks/sms/arkesel/status.
# Empty = no receipts. Requires ARKESEL_WEBHOOK_SECRET.
ARKESEL_DLR_CALLBACK_URL=
# Signing secret for delivery reports: call POST /api/v2/webhooks/secret/rotate
# once (Arkesel only signs after that), then copy it from GET /api/v2/webhooks/secret.
ARKESEL_WEBHOOK_SECRET=REPLACE_VIA_SECRET_MANAGER
# Arkesel does not sign USSD callbacks. Register the endpoint as
#   https://<host>/webhooks/ussd/arkesel/session?token=<one of these>
# (24+ characters each; comma-separate two while rotating the registered URL).
ARKESEL_USSD_TOKEN=REPLACE_VIA_SECRET_MANAGER
# Optional allowlist of Arkesel's USSD source addresses (IPs or CIDRs).
ARKESEL_USSD_ALLOWED_IPS=
# Behind a reverse proxy that OVERWRITES this header with the client address
# (e.g. X-Real-IP), name it so the allowlist sees the real caller.
ARKESEL_CLIENT_IP_HEADER=

# eSMS Africa (adapter not built yet)
ESMS_API_KEY=REPLACE_VIA_SECRET_MANAGER
ESMS_WEBHOOK_SECRET=REPLACE_VIA_SECRET_MANAGER

# DeepInfra AI configuration (real). LLM_PROVIDER=mock is a development/test simulator.
LLM_PROVIDER=deepinfra
DEEPINFRA_BASE_URL=https://api.deepinfra.com/v1/openai
DEEPINFRA_API_KEY=REPLACE_VIA_SECRET_MANAGER
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
LLM_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=300
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_MS=15000
# USD per 1M tokens, "model=in:out,..." — verify against DeepInfra pricing.
LLM_PRICES=openai/gpt-oss-20b=0.03:0.14
MOCK_LLM_LATENCY_MS=400

# Quotas & financial safeguards
DAILY_PER_NUMBER_FREE_CAP=15
GLOBAL_DAILY_SMS_SEGMENT_CAP=500
GLOBAL_DAILY_SPEND_CAP_USD=15.00
SMS_SEGMENT_COST_USD=0.025
CONTEXT_TTL_HOURS=24
CONTEXT_MAX_TURNS=6
CONTEXT_MAX_INPUT_TOKENS=800
RETENTION_DAYS=30
MAX_MORE_PAGES=1
PER_NUMBER_RATE_LIMIT_PER_MINUTE=6
MAX_FAILED_CODE_ATTEMPTS_PER_DAY=5
ALLOW_UCS2_LOCAL_LANGUAGE=true

# Admin & metrics (required outside development)
ADMIN_API_TOKEN=REPLACE_VIA_SECRET_MANAGER
METRICS_TOKEN=REPLACE_VIA_SECRET_MANAGER

# Grounding store: path overrides the embedded seed
GROUNDING_SEED_PATH=
GROUNDING_REFRESH_SECONDS=300

# Worker
WORKER_CONCURRENCY=4
WORKER_POLL_MS=500
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
