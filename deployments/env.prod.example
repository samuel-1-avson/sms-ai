# Environment for the pilot stack (deployments/compose.prod.yaml).
#
# Create deployments/.env.prod with scripts/init_env_prod.sh, which copies
# this file and fills in every generated secret. Then edit the lines marked
# EDIT. docs/DEPLOYMENT.md walks through it.
#
# - Keep the file chmod 600 and never commit it (.gitignore covers it).
# - Store a copy of the key lines (ENCRYPTION_KEYS_V*, HMAC_KEYS_V*) in a
#   password manager. Without them the database and every dump are unreadable.
# - Compose reads this file twice: to fill in compose.prod.yaml, and as the
#   api/worker environment. Single-quote any value that contains a "$".
# - Empty deployment secrets stop `docker compose` with an error. App secrets
#   left as REPLACE_... count as unset, and the app refuses to start.

# --- Edge (Caddy) -------------------------------------------------------------
# EDIT: public hostname. Its DNS A record must point at the VM before the first start.
DOMAIN=sms-ai.example.com
# EDIT: Let's Encrypt account contact.
ACME_EMAIL=ops@example.com
# EDIT: space-separated IPs/CIDRs allowed to reach /admin, /metrics, /readyz and /grafana.
OPS_ALLOWED_CIDRS=203.0.113.10/32
# Dry runs only: `local_certs` uses Caddy's internal CA instead of Let's Encrypt.
CADDY_GLOBAL_OPTIONS=
# Dry runs only: other host ports or bind address. Production publishes 0.0.0.0:80 and 0.0.0.0:443.
#PUBLIC_BIND_ADDR=127.0.0.1
#HTTP_PORT=8480
#HTTPS_PORT=8443

# --- Image --------------------------------------------------------------------
# Tag built on the VM (no registry). Use the git commit for easy rollbacks.
SMSAI_IMAGE_TAG=pilot

# --- Database and backups -------------------------------------------------------
# Generated. Hex only: it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
# Host directory for nightly dumps. Copy it off the VM (docs/DEPLOYMENT.md §7).
BACKUP_DIR=/var/backups/smsai
BACKUP_HOUR_UTC=2
BACKUP_RETENTION_DAYS=14

# --- Monitoring -----------------------------------------------------------------
# Generated. Only used when Grafana first creates its database.
GRAFANA_ADMIN_PASSWORD=
# EDIT: Slack-compatible incoming webhook for alerts (Slack, Mattermost, Rocket.Chat,
# or a Discord webhook URL with /slack appended).
ALERT_SLACK_WEBHOOK_URL=
# Default https://$DOMAIN/grafana/. Set it when the public URL has a port (dry runs).
#GRAFANA_ROOT_URL=https://localhost:8443/grafana/
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=4GB

# --- Application ------------------------------------------------------------------
# .env.example documents every setting and its default. compose.prod.yaml sets
# DATABASE_URL, HTTP_ADDR, AUTO_MIGRATE and EMBEDDED_WORKER itself.
# production refuses mock providers. staging allows them (dry runs).
APP_ENV=production
LOG_LEVEL=info

# Generated by `admin genkey`. Rotation: docs/RUNBOOKS.md.
CURRENT_KEY_VERSION=1
ENCRYPTION_KEYS_V1=REPLACE_WITH_ADMIN_GENKEY_OUTPUT
HMAC_KEYS_V1=REPLACE_WITH_ADMIN_GENKEY_OUTPUT
ADMIN_API_TOKEN=REPLACE_WITH_ADMIN_GENKEY_OUTPUT
# Also used by Prometheus to scrape the api and worker.
METRICS_TOKEN=REPLACE_WITH_ADMIN_GENKEY_OUTPUT

# Channel: the Android gateway phone (apps/gateway/README.md).
PRIMARY_SMS_PROVIDER=gateway
SMS_SERVICE_ID=GATEWAY-SIM
# Generated. The phone signs every request with it; `admin gateway-pair` puts it in the pairing QR code.
GATEWAY_DEVICE_SECRET=REPLACE_WITH_RANDOM
# EDIT: the gateway SIM's own number, so texts from it are never answered.
GATEWAY_PHONE_NUMBER=
# EDIT: the public origin the phone uses, normally https://<DOMAIN>.
GATEWAY_PUBLIC_URL=https://sms-ai.example.com

# EDIT: DeepInfra. production refuses LLM_PROVIDER=mock.
LLM_PROVIDER=deepinfra
DEEPINFRA_API_KEY=REPLACE_VIA_SECRET_MANAGER
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
LLM_REASONING_EFFORT=low
# USD per 1M tokens, "model=in:out,...". Check DeepInfra's current prices.
LLM_PRICES=openai/gpt-oss-20b=0.03:0.14

# Quotas and spend safeguards (the DailySpend alerts use the cap).
DAILY_PER_NUMBER_FREE_CAP=15
GLOBAL_DAILY_SMS_SEGMENT_CAP=200
GLOBAL_DAILY_SPEND_CAP_USD=15.00
SMS_SEGMENT_COST_USD=0.025
RETENTION_DAYS=30
